@model ESTRO.Models.Product

<div class="container mt-5">

    <div class="row">

        <div class="col-md-6">

            <img src="@Model.ImageUrl"
                 class="img-fluid rounded" />

        </div>

        <div class="col-md-6">

            <h1>@Model.Name</h1>

            <h3 class="mt-3">
                ৳ @Model.Price
            </h3>

            <p class="mt-4">
                @Model.Description
            </p>

            <h5>
                Category:
                @Model.Category
            </h5>

            <h5>
                Stock:
                @Model.Stock
            </h5>

            <a class="btn btn-dark mt-4"
               asp-controller="Cart"
               asp-action="AddToCart"

               asp-route-id="@Model.Id">

                Add To Cart
                <a asp-controller="Wishlist"
                   asp-action="Add"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-danger mt-3">

                    ❤️ Add To Wishlist

                </a>
            </a>
            <!-- RELATED PRODUCTS -->

            <section class="container mt-5">

                <h2 class="text-center mb-5">
                    You May Also Like
                </h2>

                <div class="row g-4">

                    @foreach (var item in ViewBag.RelatedProducts)
                    {
                        <div class="col-md-3">

                            <div class="card shadow border-0 h-100">

                                <img src="@item.ImageUrl"
                                     class="card-img-top"
                                     height="300"
                                     style="object-fit:cover;" />

                                <div class="card-body text-center">

                                    <h5>@item.Name</h5>

                                    <p class="fw-bold">
                                        ৳ @item.Price
                                    </p>

                                    <a asp-controller="Products"
                                       asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-dark">

                                        View Product

                                    </a>

                                </div>

                            </div>

                        </div>
                    }

                </div>

            </section>

        </div>

    </div>

</div>
<!-- REVIEWS -->

<section class="container mt-5">

    <h2 class="mb-4">
        Customer Reviews
    </h2>

    <!-- REVIEW FORM -->

    <form asp-controller="Products"
          asp-action="AddReview"
          method="post"
          class="mb-5">

        <input type="hidden"
               name="ProductId"
               value="@Model.Id" />

        <input class="form-control mb-3"
               type="text"
               name="CustomerName"
               placeholder="Your Name"
               required />

        <select class="form-select mb-3"
                name="Rating"
                required>

            <option value="">Rating</option>

            <option value="5">⭐⭐⭐⭐⭐</option>
            <option value="4">⭐⭐⭐⭐</option>
            <option value="3">⭐⭐⭐</option>
            <option value="2">⭐⭐</option>
            <option value="1">⭐</option>

        </select>

        <textarea class="form-control mb-3"
                  name="Comment"
                  placeholder="Write review..."
                  rows="4"
                  required></textarea>

        <button class="btn btn-dark"
                type="submit">

            Submit Review

        </button>

    </form>

    <!-- REVIEW LIST -->
    @foreach (var review in ViewBag.Reviews)
    {
        <div class="card shadow-sm mb-3 border-0">

            <div class="card-body">

                <h5>@review.CustomerName</h5>

                <p>
                    Rating: @review.Rating ⭐
                </p>

                <p>
                    @review.Comment
                </p>

            </div>

        </div>
    }

</section>